# Copy this file to `.env` at the repository root.
#
# The development commands — `npm test`, `npm run test:live`, `npm run eval`,
# `npm run record-fixtures` — read it automatically. Anything already set in
# your shell wins over what is in here.
#
# The published server does NOT read a .env by default: a host launches it with
# the host's working directory, and picking up whatever .env happens to be
# there is a good way to load the wrong credentials. Point it at one explicitly
# with CH_ENV_FILE=/absolute/path/to/.env if you want that behaviour.
#
# `.env` is gitignored. Do not commit it.

# Required for the server, the live smoke test and fixture recording.
# Create a key at https://developer.company-information.service.gov.uk/
#   1. Register / sign in
#   2. Create an application — choose the LIVE environment, not Test
#   3. Create a key of type REST (a stream key authenticates the same way but
#      is for a different service and will not work here)
COMPANIES_HOUSE_API_KEY=

# For `npm run eval` only, which asks a model which tool it would reach for.
# Either key works. If both are set, OpenRouter is used unless --provider says
# otherwise. No Companies House key is needed for the eval; nothing is executed.
#
# https://openrouter.ai/keys  — defaults to z-ai/glm-5.2, about 4p per full run
OPENROUTER_API_KEY=

# https://console.anthropic.com — defaults to claude-opus-5
ANTHROPIC_API_KEY=

# Optional. Real company numbers for the two fixtures that need a company which
# is genuinely dissolved and one with a genuine insolvency case.
# CH_FIXTURE_DISSOLVED_COMPANY=
# CH_FIXTURE_INSOLVENT_COMPANY=

# Optional. Override only if you are pointing at a sandbox or a proxy.
# CH_API_BASE_URL=https://api.company-information.service.gov.uk

# Optional. Requests per rate-limit window. Companies House documents 600 per
# five minutes per key. Lower this if the key is shared with another process.
# CH_RATE_LIMIT=600
# CH_RATE_WINDOW_MS=300000
# CH_RATE_SAFETY_MARGIN=0.95

# Optional. Response cache. Disable with CH_CACHE_ENABLED=false.
# CH_CACHE_ENABLED=true
# CH_CACHE_DIR=/custom/path

# Optional. Per-request timeout and retry behaviour.
# CH_TIMEOUT_MS=10000
# CH_MAX_RETRIES=3

# Optional. error | warn | info | debug. Logs are written to stderr only.
# CH_LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Hosted deployment only. Ignored entirely by the stdio server.
# Full guide, including Cloudflare Workers: docs/deployment.md
# ---------------------------------------------------------------------------

# Where the HTTP server listens. Loopback by default on purpose: starting the
# server should not be the same thing as publishing it, and this process holds
# an API key. Set 0.0.0.0 when you mean to accept external connections.
# CH_HTTP_HOST=127.0.0.1
# CH_HTTP_PORT=8787

# Origins allowed to reach the endpoint from a browser, comma separated. MCP
# clients are not browsers and send no Origin header, so leaving this empty
# blocks browser-driven requests without affecting real callers.
# CH_ALLOWED_ORIGINS=

# Largest request body accepted, in bytes.
# CH_MAX_REQUEST_BYTES=1048576

# Fair sharing of the pooled budget. Each caller is guaranteed this many
# requests per window and may exceed it whenever the window has room — a floor
# under everyone else, not a ceiling on anyone. Defaults to an eighth of the
# effective limit (71 of 570). Raise it for a few heavy batch users; lower it
# for many light ones.
# CH_CLIENT_RESERVATION=71

# How many not-yet-seen callers to keep a reservation free for, so a busy
# caller cannot spend the window to nothing before a newcomer arrives.
# CH_NEWCOMER_ALLOWANCE=1

# Upper bound on distinct callers tracked for fair sharing.
# CH_MAX_TRACKED_CLIENTS=10000

# Whether a caller may supply their own key via X-Companies-House-Api-Key and
# get a private budget. This is the pressure valve for anyone who finds the
# shared budget too tight.
# CH_ALLOW_CLIENT_KEYS=true

# How long a request waits for budget before failing with RATE_LIMITED. A
# limiter that waits forever suits a CLI and hangs a server.
# CH_MAX_WAIT_MS=60000

# Whether to believe X-Forwarded-For when identifying a caller. Off by default:
# the header is set by the caller, so a client that varies it per request would
# mint a fresh fair-share reservation every time. Turn it on only when a proxy
# you control sits in front and overwrites it. Cloudflare's CF-Connecting-IP is
# trusted regardless, because the platform sets it and strips any client copy.
# CH_TRUST_PROXY_HEADERS=false
