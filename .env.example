# Copy this file to `.env` at the repository root.
#
# The development commands — `npm test`, `npm run test:live`, `npm run eval`,
# `npm run record-fixtures` — read it automatically. Anything already set in
# your shell wins over what is in here.
#
# The published server does NOT read a .env by default: a host launches it with
# the host's working directory, and picking up whatever .env happens to be
# there is a good way to load the wrong credentials. Point it at one explicitly
# with CH_ENV_FILE=/absolute/path/to/.env if you want that behaviour.
#
# `.env` is gitignored. Do not commit it.

# Required for the server, the live smoke test and fixture recording.
# Create a key at https://developer.company-information.service.gov.uk/
#   1. Register / sign in
#   2. Create an application — choose the LIVE environment, not Test
#   3. Create a key of type REST (a stream key authenticates the same way but
#      is for a different service and will not work here)
COMPANIES_HOUSE_API_KEY=

# For `npm run eval` only, which asks a model which tool it would reach for.
# Either key works. If both are set, OpenRouter is used unless --provider says
# otherwise. No Companies House key is needed for the eval; nothing is executed.
#
# https://openrouter.ai/keys  — defaults to z-ai/glm-5.2, about 4p per full run
OPENROUTER_API_KEY=

# https://console.anthropic.com — defaults to claude-opus-5
ANTHROPIC_API_KEY=

# Optional. Real company numbers for the two fixtures that need a company which
# is genuinely dissolved and one with a genuine insolvency case.
# CH_FIXTURE_DISSOLVED_COMPANY=
# CH_FIXTURE_INSOLVENT_COMPANY=

# Optional. Override only if you are pointing at a sandbox or a proxy.
# CH_API_BASE_URL=https://api.company-information.service.gov.uk

# Optional. Requests per rate-limit window. Companies House documents 600 per
# five minutes per key. Lower this if the key is shared with another process.
# CH_RATE_LIMIT=600
# CH_RATE_WINDOW_MS=300000
# CH_RATE_SAFETY_MARGIN=0.95

# Optional. Response cache. Disable with CH_CACHE_ENABLED=false.
# CH_CACHE_ENABLED=true
# CH_CACHE_DIR=/custom/path

# Optional. Per-request timeout and retry behaviour.
# CH_TIMEOUT_MS=10000
# CH_MAX_RETRIES=3

# Optional. error | warn | info | debug. Logs are written to stderr only.
# CH_LOG_LEVEL=info
