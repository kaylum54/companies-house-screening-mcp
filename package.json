{
  "name": "companies-house-screening-mcp",
  "version": "0.1.1",
  "description": "MCP server for screening UK companies against the Companies House register: batch supplier screening, one-call company snapshots, and factual signals rather than a risk score.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "companies-house",
    "uk",
    "due-diligence",
    "kyb",
    "supplier-screening",
    "counterparty-risk",
    "claude"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kaylum54/companies-house-screening-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/kaylum54/companies-house-screening-mcp/issues"
  },
  "homepage": "https://github.com/kaylum54/companies-house-screening-mcp#readme",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "companies-house-screening-mcp": "./dist/bin.js",
    "companies-house-screening-mcp-http": "./dist/http-bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "vitest run --config vitest.live.config.ts",
    "record-fixtures": "tsx scripts/record-fixtures.ts",
    "prepublishOnly": "npm run release:check",
    "docs:generate": "tsx scripts/generate-tool-docs.ts && tsx scripts/generate-recipes.ts",
    "docs:check": "tsx scripts/generate-tool-docs.ts --check && tsx scripts/generate-recipes.ts --check",
    "measure": "tsx scripts/measure-projections.ts",
    "eval": "tsx evals/run.ts",
    "prepack": "npm run build",
    "release:check": "tsx scripts/release-check.ts",
    "eval:compare": "tsx scripts/compare-evals.ts",
    "start:http": "node dist/http-bin.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "author": "Kaylum Jarvis",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
