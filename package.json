{
  "name": "companies-house-mcp",
  "version": "0.1.0",
  "description": "MCP server for the UK Companies House public data API. Read-only, rate-limit aware, with question-shaped tools rather than endpoint wrappers.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "companies-house",
    "uk",
    "due-diligence",
    "kyb",
    "claude"
  ],
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "companies-house-mcp": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:live": "CH_LIVE_SMOKE=1 vitest run tests/live.smoke.test.ts",
    "record-fixtures": "tsx scripts/record-fixtures.ts",
    "prepublishOnly": "npm run typecheck && npm run docs:check && npm run test && npm run build",
    "docs:generate": "tsx scripts/generate-tool-docs.ts && tsx scripts/generate-recipes.ts",
    "docs:check": "tsx scripts/generate-tool-docs.ts --check && tsx scripts/generate-recipes.ts --check",
    "measure": "tsx scripts/measure-projections.ts",
    "eval": "tsx evals/run.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^4.1.11",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
