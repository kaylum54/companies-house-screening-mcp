{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    // Narrowing `include` to src drops the ambient Node types that the wider
    // project config picks up, so they are requested explicitly here.
    "types": ["node"],
    // Neither map is usable by a consumer: src/ is not published, so they
    // point at files that are not there. They were half the tarball.
    "sourceMap": false,
    "declarationMap": false,
    // A build that emitted despite type errors is how a broken package gets
    // published. `prepublishOnly` runs this.
    "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
